{
    "name": "restruct/silverstripe-webp-images",
    "description": "Serve resized JPEG and PNG images as WebP in Silverstripe 5 and 6, using core image variants, with an optional <picture> helper that adds AVIF",
    "type": "silverstripe-vendormodule",
    "license": "MIT",
    "keywords": [
        "silverstripe",
        "silverstripe-module",
        "webp",
        "avif",
        "images",
        "picture",
        "assets",
        "performance"
    ],
    "homepage": "https://github.com/restruct/silverstripe-webp-images",
    "authors": [
        {
            "name": "Restruct",
            "email": "dev@restruct.nl",
            "homepage": "https://restruct.nl"
        },
        {
            "name": "WeDevelop",
            "email": "development@wedevelop.nl"
        }
    ],
    "require": {
        "php": "^8.1",
        "silverstripe/framework": "^5.3 || ^6",
        "silverstripe/assets": "^2.3 || ^3"
    },
    "require-dev": {
        "silverstripe/recipe-testing": "^3 || ^4"
    },
    "suggest": {
        "restruct/silverstripe-signed-asset-urls": "^1.4 - signed URLs for protected images; AutoURL/SignedURL then sign the WebP variant"
    },
    "conflict": {
        "wedevelopnl/silverstripe-webp-images": "*"
    },
    "autoload": {
        "psr-4": {
            "Restruct\\Silverstripe\\WebpImages\\": "src/",
            "WeDevelop\\WebpImages\\": "src/Legacy/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Restruct\\Silverstripe\\WebpImages\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/vendor-plugin": true,
            "silverstripe/recipe-plugin": true
        }
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/restruct"
        }
    ]
}
